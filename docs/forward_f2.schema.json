{
  "$defs": {
    "ConditionTrigger": {
      "additionalProperties": false,
      "description": "F3 input contract. This is NEVER a fill or a settlement result.",
      "properties": {
        "version": {
          "const": "forward-condition-v1",
          "default": "forward-condition-v1",
          "title": "Version",
          "type": "string"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "research_id": {
          "title": "Research Id",
          "type": "string"
        },
        "registration_id": {
          "title": "Registration Id",
          "type": "string"
        },
        "protocol_hash": {
          "title": "Protocol Hash",
          "type": "string"
        },
        "snapshot_id": {
          "title": "Snapshot Id",
          "type": "string"
        },
        "result_hash": {
          "title": "Result Hash",
          "type": "string"
        },
        "direction": {
          "enum": [
            "LONG",
            "SHORT"
          ],
          "title": "Direction",
          "type": "string"
        },
        "signal_confirmed_ms": {
          "title": "Signal Confirmed Ms",
          "type": "integer"
        },
        "observed_available_ms": {
          "title": "Observed Available Ms",
          "type": "integer"
        },
        "decision_available_ms": {
          "title": "Decision Available Ms",
          "type": "integer"
        },
        "next_tradable_ms": {
          "title": "Next Tradable Ms",
          "type": "integer"
        },
        "hypothesis_expires_ms": {
          "title": "Hypothesis Expires Ms",
          "type": "integer"
        },
        "original_conditions": {
          "additionalProperties": true,
          "title": "Original Conditions",
          "type": "object"
        },
        "confirmation_bar": {
          "additionalProperties": true,
          "title": "Confirmation Bar",
          "type": "object"
        },
        "evidence_fingerprint": {
          "title": "Evidence Fingerprint",
          "type": "string"
        },
        "previous_state": {
          "title": "Previous State",
          "type": "string"
        },
        "new_state": {
          "const": "ENTRY_ELIGIBLE",
          "default": "ENTRY_ELIGIBLE",
          "title": "New State",
          "type": "string"
        },
        "collection_mode": {
          "enum": [
            "CONTEMPORANEOUS",
            "BACKFILL"
          ],
          "title": "Collection Mode",
          "type": "string"
        },
        "data_quality": {
          "const": "VALID",
          "default": "VALID",
          "title": "Data Quality",
          "type": "string"
        },
        "continuity": {
          "const": "COMPLETE",
          "default": "COMPLETE",
          "title": "Continuity",
          "type": "string"
        },
        "requires_revalidation": {
          "const": true,
          "default": true,
          "title": "Requires Revalidation",
          "type": "boolean"
        },
        "is_simulated_fill": {
          "const": false,
          "default": false,
          "title": "Is Simulated Fill",
          "type": "boolean"
        },
        "allow_new_risk": {
          "const": false,
          "default": false,
          "title": "Allow New Risk",
          "type": "boolean"
        },
        "execution_enabled": {
          "const": false,
          "default": false,
          "title": "Execution Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "event_id",
        "research_id",
        "registration_id",
        "protocol_hash",
        "snapshot_id",
        "result_hash",
        "direction",
        "signal_confirmed_ms",
        "observed_available_ms",
        "decision_available_ms",
        "next_tradable_ms",
        "hypothesis_expires_ms",
        "original_conditions",
        "confirmation_bar",
        "evidence_fingerprint",
        "previous_state",
        "collection_mode"
      ],
      "title": "ConditionTrigger",
      "type": "object"
    },
    "FrozenCandidate": {
      "additionalProperties": false,
      "properties": {
        "registration_id": {
          "title": "Registration Id",
          "type": "string"
        },
        "research_id": {
          "title": "Research Id",
          "type": "string"
        },
        "registration_hash": {
          "title": "Registration Hash",
          "type": "string"
        },
        "protocol_hash": {
          "title": "Protocol Hash",
          "type": "string"
        },
        "snapshot_id": {
          "title": "Snapshot Id",
          "type": "string"
        },
        "result_hash": {
          "title": "Result Hash",
          "type": "string"
        },
        "instrument": {
          "title": "Instrument",
          "type": "string"
        },
        "direction": {
          "enum": [
            "LONG",
            "SHORT"
          ],
          "title": "Direction",
          "type": "string"
        },
        "plan": {
          "additionalProperties": true,
          "title": "Plan",
          "type": "object"
        },
        "original_result": {
          "additionalProperties": true,
          "title": "Original Result",
          "type": "object"
        },
        "clock": {
          "$ref": "#/$defs/PlanTiming"
        },
        "first_bar_open_ms": {
          "title": "First Bar Open Ms",
          "type": "integer"
        },
        "first_check_ms": {
          "title": "First Check Ms",
          "type": "integer"
        },
        "registered_ms": {
          "title": "Registered Ms",
          "type": "integer"
        },
        "namespace": {
          "default": "PRODUCTION",
          "enum": [
            "PRODUCTION",
            "FIXTURE"
          ],
          "title": "Namespace",
          "type": "string"
        },
        "execution_enabled": {
          "const": false,
          "default": false,
          "title": "Execution Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "registration_id",
        "research_id",
        "registration_hash",
        "protocol_hash",
        "snapshot_id",
        "result_hash",
        "instrument",
        "direction",
        "plan",
        "clock",
        "first_bar_open_ms",
        "first_check_ms",
        "registered_ms"
      ],
      "title": "FrozenCandidate",
      "type": "object"
    },
    "PlanTiming": {
      "additionalProperties": false,
      "properties": {
        "cutoff_ms": {
          "exclusiveMinimum": 0,
          "title": "Cutoff Ms",
          "type": "integer"
        },
        "hypothesis_expires_ms": {
          "exclusiveMinimum": 0,
          "title": "Hypothesis Expires Ms",
          "type": "integer"
        },
        "confirmation_bars": {
          "maximum": 48,
          "minimum": 2,
          "title": "Confirmation Bars",
          "type": "integer"
        },
        "market_data_ttl_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 900,
          "title": "Market Data Ttl Seconds",
          "type": "integer"
        },
        "revalidation_ttl_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 300,
          "title": "Revalidation Ttl Seconds",
          "type": "integer"
        },
        "bar_interval": {
          "const": "1h",
          "default": "1h",
          "title": "Bar Interval",
          "type": "string"
        },
        "rules_version": {
          "const": "breakout-retest-v1",
          "default": "breakout-retest-v1",
          "title": "Rules Version",
          "type": "string"
        }
      },
      "required": [
        "cutoff_ms",
        "hypothesis_expires_ms",
        "confirmation_bars",
        "market_data_ttl_seconds",
        "revalidation_ttl_seconds"
      ],
      "title": "PlanTiming",
      "type": "object"
    },
    "ScanLimits": {
      "additionalProperties": false,
      "properties": {
        "max_requests": {
          "default": 8,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Requests",
          "type": "integer"
        },
        "max_candidates": {
          "default": 20,
          "maximum": 200,
          "minimum": 1,
          "title": "Max Candidates",
          "type": "integer"
        },
        "max_records": {
          "default": 200,
          "maximum": 2000,
          "minimum": 1,
          "title": "Max Records",
          "type": "integer"
        },
        "max_pages": {
          "default": 3,
          "maximum": 5,
          "minimum": 1,
          "title": "Max Pages",
          "type": "integer"
        },
        "max_seconds": {
          "default": 180,
          "maximum": 600,
          "minimum": 5,
          "title": "Max Seconds",
          "type": "integer"
        },
        "delivery_grace_seconds": {
          "default": 90,
          "maximum": 300,
          "minimum": 1,
          "title": "Delivery Grace Seconds",
          "type": "integer"
        },
        "execution_enabled": {
          "const": false,
          "default": false,
          "title": "Execution Enabled",
          "type": "boolean"
        }
      },
      "title": "ScanLimits",
      "type": "object"
    },
    "TrackingEvent": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "forward-f2-v1",
          "default": "forward-f2-v1",
          "title": "Version",
          "type": "string"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "registration_id": {
          "title": "Registration Id",
          "type": "string"
        },
        "research_id": {
          "title": "Research Id",
          "type": "string"
        },
        "namespace": {
          "enum": [
            "PRODUCTION",
            "FIXTURE"
          ],
          "title": "Namespace",
          "type": "string"
        },
        "protocol_hash": {
          "title": "Protocol Hash",
          "type": "string"
        },
        "snapshot_id": {
          "title": "Snapshot Id",
          "type": "string"
        },
        "result_hash": {
          "title": "Result Hash",
          "type": "string"
        },
        "registration_hash": {
          "title": "Registration Hash",
          "type": "string"
        },
        "direction": {
          "enum": [
            "LONG",
            "SHORT"
          ],
          "title": "Direction",
          "type": "string"
        },
        "kind": {
          "enum": [
            "BAR_OBSERVATION",
            "STATE_TRANSITION",
            "WAIT",
            "PAUSED",
            "CLOCK_EXPIRY"
          ],
          "title": "Kind",
          "type": "string"
        },
        "recorded_ms": {
          "exclusiveMinimum": 0,
          "title": "Recorded Ms",
          "type": "integer"
        },
        "market_cutoff_ms": {
          "exclusiveMinimum": 0,
          "title": "Market Cutoff Ms",
          "type": "integer"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "evidence_fingerprint": {
          "title": "Evidence Fingerprint",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "previous_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous Hash"
        },
        "event_hash": {
          "title": "Event Hash",
          "type": "string"
        },
        "execution_enabled": {
          "const": false,
          "default": false,
          "title": "Execution Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "event_id",
        "registration_id",
        "research_id",
        "namespace",
        "protocol_hash",
        "snapshot_id",
        "result_hash",
        "registration_hash",
        "direction",
        "kind",
        "recorded_ms",
        "market_cutoff_ms",
        "source",
        "evidence_fingerprint",
        "payload",
        "previous_hash",
        "event_hash"
      ],
      "title": "TrackingEvent",
      "type": "object"
    }
  },
  "title": "TradingAgents F2 lifecycle observation and condition-only F3 contracts"
}
