{
  "$defs": {
    "ForwardProtocol": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "forward-f1-v1",
          "title": "Version",
          "type": "string"
        },
        "execution_enabled": {
          "const": false,
          "title": "Execution Enabled",
          "type": "boolean"
        },
        "registration_max_delay_ms": {
          "exclusiveMinimum": 0,
          "maximum": 60000,
          "title": "Registration Max Delay Ms",
          "type": "integer"
        },
        "prospective_cutoff_max_age_ms": {
          "exclusiveMinimum": 0,
          "maximum": 300000,
          "title": "Prospective Cutoff Max Age Ms",
          "type": "integer"
        },
        "clock": {
          "title": "Clock",
          "type": "string"
        },
        "lifecycle": {
          "title": "Lifecycle",
          "type": "string"
        },
        "entry": {
          "title": "Entry",
          "type": "string"
        },
        "costs": {
          "additionalProperties": true,
          "title": "Costs",
          "type": "object"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        },
        "metrics": {
          "additionalProperties": true,
          "title": "Metrics",
          "type": "object"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "version",
        "execution_enabled",
        "registration_max_delay_ms",
        "prospective_cutoff_max_age_ms",
        "clock",
        "lifecycle",
        "entry",
        "costs",
        "labels",
        "metrics",
        "limitations"
      ],
      "title": "ForwardProtocol",
      "type": "object"
    },
    "FutureBarObservation": {
      "additionalProperties": false,
      "description": "F2 interchange contract only; F1 does not collect or process bars.",
      "properties": {
        "version": {
          "const": "forward-observation-v1",
          "default": "forward-observation-v1",
          "title": "Version",
          "type": "string"
        },
        "registration_id": {
          "title": "Registration Id",
          "type": "string"
        },
        "bar_open_ms": {
          "exclusiveMinimum": 0,
          "title": "Bar Open Ms",
          "type": "integer"
        },
        "bar_close_ms": {
          "exclusiveMinimum": 0,
          "title": "Bar Close Ms",
          "type": "integer"
        },
        "available_ms": {
          "exclusiveMinimum": 0,
          "title": "Available Ms",
          "type": "integer"
        },
        "recorded_ms": {
          "exclusiveMinimum": 0,
          "title": "Recorded Ms",
          "type": "integer"
        },
        "bar_fingerprint": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Bar Fingerprint",
          "type": "string"
        },
        "confirm": {
          "const": "1",
          "default": "1",
          "title": "Confirm",
          "type": "string"
        },
        "execution_enabled": {
          "const": false,
          "default": false,
          "title": "Execution Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "registration_id",
        "bar_open_ms",
        "bar_close_ms",
        "available_ms",
        "recorded_ms",
        "bar_fingerprint"
      ],
      "title": "FutureBarObservation",
      "type": "object"
    },
