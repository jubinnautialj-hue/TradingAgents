{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R1.4 deployment preparation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "default": "ubuntu-operations-r14-v1",
      "const": "ubuntu-operations-r14-v1"
    },
    "user": {
      "type": "string",
      "default": "ta-research",
      "pattern": "^[a-z][a-z0-9-]{0,30}$"
    },
    "release_dir": {
      "type": "string",
      "default": "/opt/tradingagents/releases/r14-reviewed"
    },
    "data_dir": {
      "type": "string",
      "default": "/var/lib/tradingagents/r14"
    },
    "config_dir": {
      "type": "string",
      "default": "/etc/tradingagents-r14"
    },
    "python_minor": {
      "type": "string",
      "default": "3.13",
      "const": "3.13"
    },
    "min_free_bytes": {
      "type": "integer",
      "default": 2147483648
    },
    "min_available_memory_bytes": {
      "type": "integer",
      "default": 1073741824
    },
    "clock_offset_limit_ms": {
      "type": "integer",
      "default": 1000
    },
    "execution_enabled": {
      "type": "boolean",
      "default": false,
      "const": false
    },
    "allow_new_risk": {
      "type": "boolean",
      "default": false,
      "const": false
    },
    "simulation_admitted": {
      "type": "boolean",
      "default": false,
      "const": false
    }
  },
  "description": "Deployment.__post_init__ additionally validates path isolation, non-root identity and resource floors."
}
