{
  "$defs": {
    "PaperEvent": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "forward-paper-v1",
          "default": "forward-paper-v1",
          "title": "Version",
          "type": "string"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "recorded_ms": {
          "exclusiveMinimum": 0,
          "title": "Recorded Ms",
          "type": "integer"
        },
        "registration_id": {
          "title": "Registration Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "policy_hash": {
          "title": "Policy Hash",
          "type": "string"
        },
        "previous_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous Hash"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "event_hash": {
          "title": "Event Hash",
          "type": "string"
        },
        "simulation_admitted": {
          "const": false,
          "default": false,
          "title": "Simulation Admitted",
          "type": "boolean"
        },
        "allow_new_risk": {
          "const": false,
          "default": false,
          "title": "Allow New Risk",
          "type": "boolean"
        },
        "execution_enabled": {
          "const": false,
          "default": false,
          "title": "Execution Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "event_id",
        "recorded_ms",
        "registration_id",
        "kind",
        "policy_hash",
        "previous_hash",
        "payload",
        "event_hash"
      ],
      "title": "PaperEvent",
      "type": "object"
    },
    "PaperJournal": {
      "additionalProperties": false,
      "properties": {
        "policy": {
          "$ref": "#/$defs/PaperProtocol"
        },
        "code_hash": {
          "title": "Code Hash",
          "type": "string"
        },
        "namespace": {
          "enum": [
            "PRODUCTION",
            "FIXTURE"
          ],
          "title": "Namespace",
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/PaperEvent"
          },
          "maxItems": 20000,
          "title": "Events",
          "type": "array"
        }
      },
      "required": [
        "policy",
        "code_hash",
        "namespace",
        "events"
      ],
      "title": "PaperJournal",
      "type": "object"
    },
    "PaperProtocol": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "forward-paper-v1",
          "default": "forward-paper-v1",
          "title": "Version",
          "type": "string"
        },
        "initial_equity": {
          "const": 10000,
          "default": 10000,
          "title": "Initial Equity",
          "type": "integer"
        },
        "notional_usdt": {
          "const": 1000,
          "default": 1000,
          "title": "Notional Usdt",
          "type": "integer"
        },
        "taker_fee_bps": {
          "const": 5,
          "default": 5,
          "title": "Taker Fee Bps",
          "type": "integer"
        },
        "maker_fee_bps": {
          "default": null,
          "title": "Maker Fee Bps",
          "type": "null"
        },
        "slippage_bps": {
          "const": 2,
          "default": 2,
          "title": "Slippage Bps",
          "type": "integer"
        },
        "max_holding_bars": {
          "const": 12,
          "default": 12,
          "title": "Max Holding Bars",
          "type": "integer"
        },
        "opening_delivery_ms": {
          "const": 15000,
          "default": 15000,
          "title": "Opening Delivery Ms",
          "type": "integer"
        },
        "revalidation_ttl_ms": {
          "const": 60000,
          "default": 60000,
          "title": "Revalidation Ttl Ms",
          "type": "integer"
        },
        "fill_rule": {
          "const": "PRECOMMITTED_FUTURE_HOUR_OPEN_OBSERVED_ON_TIME",
          "default": "PRECOMMITTED_FUTURE_HOUR_OPEN_OBSERVED_ON_TIME",
          "title": "Fill Rule",
          "type": "string"
        },
        "first_bar_target_rule": {
          "const": "CLOSE_CONFIRMED_OR_UNRESOLVED",
          "default": "CLOSE_CONFIRMED_OR_UNRESOLVED",
          "title": "First Bar Target Rule",
          "type": "string"
        },
        "same_bar_rule": {
          "const": "STOP_FIRST",
          "default": "STOP_FIRST",
          "title": "Same Bar Rule",
          "type": "string"
        },
        "funding_rule": {
          "const": "REALIZED_PAGINATED_BRACKETS_TRADE_OPEN_PROXY",
          "default": "REALIZED_PAGINATED_BRACKETS_TRADE_OPEN_PROXY",
          "title": "Funding Rule",
          "type": "string"
        },
        "simulation_admitted": {
          "const": false,
          "default": false,
          "title": "Simulation Admitted",
          "type": "boolean"
        },
        "allow_new_risk": {
          "const": false,
          "default": false,
          "title": "Allow New Risk",
          "type": "boolean"
        },
        "execution_enabled": {
          "const": false,
          "default": false,
          "title": "Execution Enabled",
          "type": "boolean"
        }
      },
      "title": "PaperProtocol",
      "type": "object"
    },
    "PaperReport": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "forward-paper-v1",
          "title": "Version",
          "type": "string"
        },
        "namespace": {
          "enum": [
            "PRODUCTION",
            "FIXTURE"
          ],
          "title": "Namespace",
          "type": "string"
        },
        "execution_enabled": {
          "const": false,
          "title": "Execution Enabled",
          "type": "boolean"
        },
        "simulation_admitted": {
          "const": false,
          "title": "Simulation Admitted",
          "type": "boolean"
        },
        "allow_new_risk": {
          "const": false,
          "title": "Allow New Risk",
          "type": "boolean"
        },
        "research": {
          "additionalProperties": true,
          "title": "Research",
          "type": "object"
        },
        "paper": {
          "additionalProperties": true,
          "title": "Paper",
          "type": "object"
        },
        "reliability": {
          "additionalProperties": true,
          "title": "Reliability",
          "type": "object"
        },
        "pairing": {
          "additionalProperties": true,
          "title": "Pairing",
          "type": "object"
        },
        "trades": {
          "items": {
            "$ref": "#/$defs/PaperState"
          },
          "title": "Trades",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "recorded_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recorded Ms"
        },
        "records_limit_reached": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Records Limit Reached"
        },
        "candidates_limit_reached": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidates Limit Reached"
        }
      },
      "required": [
        "version",
        "namespace",
        "execution_enabled",
        "simulation_admitted",
        "allow_new_risk",
        "research",
        "paper",
        "reliability",
        "pairing",
        "trades",
        "limitations"
      ],
      "title": "PaperReport",
      "type": "object"
    },
    "PaperState": {
      "additionalProperties": false,
      "properties": {
        "paper_trade_id": {
          "title": "Paper Trade Id",
          "type": "string"
        },
        "registration_id": {
          "title": "Registration Id",
          "type": "string"
        },
        "research_id": {
          "title": "Research Id",
          "type": "string"
        },
        "namespace": {
          "enum": [
            "PRODUCTION",
            "FIXTURE"
          ],
          "title": "Namespace",
          "type": "string"
        },
        "group": {
          "title": "Group",
          "type": "string"
        },
        "pair_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pair Id"
        },
        "identity": {
          "additionalProperties": true,
          "title": "Identity",
          "type": "object"
        },
        "plan": {
          "additionalProperties": true,
          "title": "Plan",
          "type": "object"
        },
        "info": {
          "additionalProperties": true,
          "title": "Info",
          "type": "object"
        },
        "trigger": {
          "additionalProperties": true,
          "title": "Trigger",
          "type": "object"
        },
        "paper_evaluation_eligible": {
          "title": "Paper Evaluation Eligible",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "SCHEDULED",
            "CANCELLED",
            "MISSED",
            "OPEN",
            "EXIT_PENDING",
            "SETTLED",
            "UNRESOLVED"
          ],
          "title": "Status",
          "type": "string"
        },
        "planned_entry_ms": {
          "title": "Planned Entry Ms",
          "type": "integer"
        },
        "revalidation": {
          "additionalProperties": true,
          "title": "Revalidation",
          "type": "object"
        },
        "cursor_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor Ms"
        },
        "position": {
          "additionalProperties": true,
          "title": "Position",
          "type": "object"
        },
        "exit": {
          "additionalProperties": true,
          "title": "Exit",
          "type": "object"
        },
        "funding": {
          "additionalProperties": true,
          "title": "Funding",
          "type": "object"
        },
        "backfill_used": {
          "default": false,
          "title": "Backfill Used",
          "type": "boolean"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "simulation_admitted": {
          "const": false,
          "default": false,
          "title": "Simulation Admitted",
          "type": "boolean"
        },
        "allow_new_risk": {
          "const": false,
          "default": false,
          "title": "Allow New Risk",
          "type": "boolean"
        },
        "execution_enabled": {
          "const": false,
          "default": false,
          "title": "Execution Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "paper_trade_id",
        "registration_id",
        "research_id",
        "namespace",
        "group",
        "pair_id",
        "identity",
        "plan",
        "info",
        "trigger",
        "paper_evaluation_eligible",
        "status",
        "planned_entry_ms",
        "revalidation"
      ],
      "title": "PaperState",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/PaperProtocol"
    },
    {
      "$ref": "#/$defs/PaperJournal"
    },
    {
      "$ref": "#/$defs/PaperState"
    },
    {
      "$ref": "#/$defs/PaperReport"
    }
  ]
}
